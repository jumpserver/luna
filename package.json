{
  "name": "jumpserver-client",
  "type": "module",
  "version": "4.1.2",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "description": "JumpServer client tool",
  "author": "JumpServer",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "bump": "bumpp",
    "set_version": "node scripts/set-version.js",
    "setup_apple_cert": "bash scripts/setup-apple-cert.sh",
    "sign_go_binary": "bash scripts/sign-go-binary.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "update:dependencies": "npx npm-check-updates -u && pnpm install && cd src-tauri && cargo update",
    "prettier": "prettier --write \"ui/**/*.{js,ts,tsx,jsx,vue,css,scss,less,html,md,json,yml,yaml}\"",
    "reset": "rm -rf node_modules .nuxt dist && cd src-tauri && cargo clean"
  },
  "dependencies": {
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.2.2",
    "@nuxt/ui": "^4.8.1",
    "@nuxtjs/i18n": "10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3",
    "mitt": "^3.0.1",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/cuida": "^1.2.5",
    "@iconify-json/fluent": "^1.2.48",
    "@iconify-json/gravity-ui": "^1.2.12",
    "@iconify-json/ix": "^1.2.11",
    "@iconify-json/lets-icons": "^1.2.2",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "^1.2.110",
    "@iconify-json/mingcute": "^1.2.7",
    "@iconify-json/proicons": "^1.2.19",
    "@iconify-json/si": "^1.2.17",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/tabler": "^1.2.35",
    "@nuxt/eslint": "^1.15.2",
    "@oxc-minify/binding-darwin-arm64": "0.133.0",
    "@oxc-transform/binding-darwin-arm64": "0.133.0",
    "@tauri-apps/cli": "^2.11.2",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "typescript": "npm:tslite@latest"
  }
}
