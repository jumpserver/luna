{
  "name": "jumpserver-client",
  "productName": "JumpServer",
  "type": "module",
  "version": "4.1.2",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "description": "JumpServer desktop application",
  "author": "JumpServer",
  "license": "MIT",
  "main": "electron/bootstrap.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm electron:dev",
    "web:dev": "nuxt dev --dotenv .env.development",
    "generate": "nuxt generate",
    "generate:client": "node scripts/generate-client.js",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "fmt": "oxfmt \"{ui,packages}/**/*.{js,ts,tsx,jsx,vue,css,scss,less,html,md,json,yml,yaml}\"",
    "fmt:check": "oxfmt --check \"{ui,packages}/**/*.{js,ts,tsx,jsx,vue,css,scss,less,html,md,json,yml,yaml}\"",
    "lint": "pnpm lint:oxlint --fix && pnpm lint:eslint --fix",
    "lint:check": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint \"**/*.vue\" --ignore-pattern .omx --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache",
    "test": "vitest run --config vitest.config.ts --browser.enabled=false --exclude \"packages/koko/app/tests/**\" --passWithNoTests && pnpm test:electron",
    "test:electron": "node --test electron/ssh-helper.test.cjs electron/replay-codec.test.mjs electron/ffmpeg-plugin.test.mjs",
    "test:electron:transcode": "pnpm --dir electron exec electron tests/replay-transcoder-app",
    "test:browser": "vitest run --config vitest.config.ts",
    "test:e2e:sftp": "playwright test --config packages/koko/playwright.config.ts",
    "test:e2e:replay": "playwright test --config packages/online-player/playwright.config.ts",
    "typecheck": "nuxt typecheck",
    "typecheck:frontend": "pnpm typecheck",
    "bump": "bumpp",
    "set_version": "node scripts/set-version.js",
    "setup_apple_cert": "bash scripts/setup-apple-cert.sh",
    "client:dev": "pnpm electron:dev",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:prepare": "pnpm generate:client && node scripts/prepare-electron-resources.mjs",
    "electron:package:dir": "pnpm electron:prepare && pnpm --dir electron exec electron-builder --projectDir .. --dir --publish never",
    "electron:build": "pnpm electron:prepare && pnpm --dir electron exec electron-builder --projectDir .. --publish never",
    "web-client:dev": "pnpm --dir web-client dev",
    "web-client:check": "pnpm --dir web-client check",
    "web-client:test-site": "pnpm --dir web-client test-site",
    "update:dependencies": "npx npm-check-updates -u && pnpm install",
    "reset": "rm -rf node_modules .nuxt dist"
  },
  "dependencies": {
    "@ai-sdk/vue": "4.0.44",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.5",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.8",
    "@jumpserver/connectors-core": "workspace:*",
    "@jumpserver/koko": "workspace:*",
    "@jumpserver/online-player": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@nuxt/icon": "2.2.2",
    "@nuxt/ui": "4.11.0",
    "@nuxtjs/i18n": "10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@uiw/codemirror-theme-dracula": "^4.25.11",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.11",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@watermark-design/dom": "^1.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ag-grid-community": "^36.0.0",
    "ag-grid-vue3": "^36.0.0",
    "ai": "7.0.44",
    "asciinema-player": "^3.10.0",
    "clipboard-polyfill": "^4.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "3.4.12",
    "driver.js": "^1.8.0",
    "fflate": "^0.8.2",
    "guacamole-common-js-jumpserver": "1.1.0-c",
    "js-untar": "^2.0.0",
    "marked": "17.0.6",
    "mitt": "^3.0.1",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pretty-bytes": "^7.1.0",
    "sql-formatter": "^9.0.0",
    "vue": "^3.5.35",
    "vue-router": "5.0.7",
    "xterm-theme": "^1.1.0",
    "zmodem-ts": "^1.0.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@iconify-json/fluent": "^1.2.48",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "1.2.109",
    "@iconify-json/mingcute": "^1.2.7",
    "@iconify-json/proicons": "^1.2.19",
    "@iconify-json/si": "^1.2.17",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/tabler": "^1.2.35",
    "@nuxt/eslint": "^1.15.2",
    "@oxc-minify/binding-darwin-arm64": "0.133.0",
    "@oxc-transform/binding-darwin-arm64": "0.133.0",
    "@types/node": "^26.1.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-oxlint": "^1.79.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "3.2.4"
  },
  "resolutions": {
    "typescript": "npm:tslite@latest"
  },
  "build": {
    "appId": "com.jumpserver.client",
    "productName": "JumpServer",
    "electronVersion": "44.0.0",
    "asar": true,
    "asarUnpack": [
      "**/node-pty/**",
      "**/*.node"
    ],
    "directories": {
      "app": "electron",
      "output": "release/electron"
    },
    "files": [
      "**/*",
      "!**/*.test.mjs",
      "!**/*.test.cjs",
      "!tests/**",
      "!MIGRATION.md",
      "!README.md"
    ],
    "extraResources": [
      {
        "from": ".output/public",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".electron-resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "JumpServer URL",
        "schemes": [
          "jms",
          "jms2"
        ]
      }
    ],
    "artifactName": "JumpServer_${version}_${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/assets/icons/icon.icns",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "electron/assets/icons/icon.ico",
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "category": "Development",
      "icon": "electron/assets/icons/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "jumpserver",
      "repo": "clients"
    }
  }
}
