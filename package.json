{
  "name": "jumpserver-client",
  "type": "module",
  "version": "4.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "description": "JumpServer client tool",
  "author": "JumpServer",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "bump": "bumpp",
    "set_version": "node scripts/set-version.js",
    "setup_apple_cert": "bash scripts/setup-apple-cert.sh",
    "sign_go_binary": "bash scripts/sign-go-binary.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "cleanup": "./cleanup.sh",
    "prettier": "prettier --write \"ui/**/*.{js,ts,tsx,jsx,vue,css,scss,less,html,md,json,yml,yaml}\"",
    "fresh-start": "./cleanup.sh && pnpm install && pnpm run tauri:dev",
    "reset": "rm -rf node_modules .nuxt dist && cd src-tauri && cargo clean"
  },
  "dependencies": {
    "@nuxt/fonts": "0.12.1",
    "@nuxt/icon": "2.0.0",
    "@nuxt/ui": "^4.2.1",
    "@nuxtjs/i18n": "10.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-log": "~2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.1",
    "mitt": "^3.0.1",
    "nuxt": "^4.2.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.5.1",
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/fluent": "^1.2.36",
    "@iconify-json/gravity-ui": "^1.2.10",
    "@iconify-json/lets-icons": "^1.2.2",
    "@iconify-json/line-md": "^1.2.11",
    "@iconify-json/lucide": "^1.2.79",
    "@iconify-json/mingcute": "^1.2.5",
    "@iconify-json/proicons": "^1.2.18",
    "@iconify-json/solar": "^1.2.5",
    "@nuxt/eslint": "^1.11.0",
    "@oxc-minify/binding-darwin-arm64": "0.102.0",
    "@oxc-transform/binding-darwin-arm64": "0.102.0",
    "@tauri-apps/cli": "^2.9.5",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "bumpp": "^10.3.2",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "typescript": "npm:tslite@latest"
  }
}
