# Dev connector proxy targets. pnpm dev loads this file through Nuxt's --dotenv option.
# Browser requests stay on the current origin and are forwarded by the Nuxt dev proxy.

JMS_KOKO_DEV_URL=http://localhost:5050

# Lion 默认复用 JMS_KOKO_DEV_URL；仅兼容独立调试时覆盖
# JMS_LION_DEV_URL=http://localhost:5050
# JMS_CHEN_DEV_URL=http://localhost:8082
