{
  "platforms": {
    "windows": {
      "match_first": [
        "rdp"
      ],
      "is_default": true,
      "is_set": true,
      "is_internal": true,
      "path": "C:\\WINDOWS\\system32\\mstsc.exe"
    },
    "macos": {
      "match_first": [
        "rdp"
      ],
      "is_default": true,
      "is_set": true,
      "is_internal": true,
      "path": "/Applications/Windows App.app"
    }
  }
}
