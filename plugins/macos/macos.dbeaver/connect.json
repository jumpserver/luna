{
  "platforms": {
    "macos": {
      "executable": {
        "type": "user_path",
        "default": "/Applications/DBeaver.app/Contents/MacOS/dbeaver",
        "required": false
      },
      "launch": {
        "type": "args",
        "template": "-con name={name}|driver={protocol}|user={username}|password={value}|database={dbname}|host={host}|port={port}|save=false|connect=true"
      },
      "display_name": "DBeaver Community"
    }
  }
}
