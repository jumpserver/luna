{
  "platform": "macos",
  "match_first": [],
  "is_default": false,
  "is_set": false,
  "is_internal": false,
  "executable": {
    "type": "user_path",
    "default": "/Applications/SecureCRT.app/Contents/MacOS/SecureCRT",
    "required": false
  },
  "launch": {
    "type": "args",
    "template": "/N {name} /T /SSH2 /ACCEPTHOSTKEYS /p {port} /password {value} /L {username} {host}"
  },
  "display_name": "SecureCRT"
}
