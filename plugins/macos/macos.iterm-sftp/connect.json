{
  "platform": "macos",
  "match_first": [],
  "is_default": false,
  "is_set": false,
  "is_internal": true,
  "executable": {
    "type": "application_bundle",
    "default": "/Applications/iTerm.app"
  },
  "launch": {
    "type": "args",
    "driver": "iterm2",
    "application_id": "com.googlecode.iterm2",
    "use_ssh_helper": true,
    "template": "{protocol} {username}@{host} -p {port} -P {value}"
  },
  "display_name": "iTerm2"
}
