{
  "platform": "macos",
  "match_first": [],
  "is_default": false,
  "is_set": false,
  "is_internal": false,
  "executable": {
    "type": "user_path",
    "default": "/Applications/MongoDB Compass.app/Contents/MacOS/MongoDB Compass",
    "required": false
  },
  "launch": {
    "type": "args",
    "template": "mongodb://{username}:{value}@{host}:{port}/{dbname}"
  },
  "display_name": "MongoDB Compass"
}
