{
  "platform": "linux",
  "match_first": [],
  "is_default": false,
  "is_set": false,
  "is_internal": true,
  "executable": {
    "type": "bundled",
    "default": "vncviewer"
  },
  "launch": {
    "type": "args",
    "template": "{host}::{port}"
  },
  "env": {
    "VNC_USERNAME": "{username}",
    "VNC_PASSWORD": "{value}"
  },
  "display_name": "TigerVNC"
}
