{
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis", "appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/bin/", "resources/plugins/", "default-config.json"],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "",
    "longDescription": "",
    "macOS": {},
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "fragmentPaths": ["./windows/fragments/user-data-and-protocol.wxs"],
        "componentRefs": ["JumpServerClientUserProtocol"]
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": true,
        "minimumWebview2Version": "110.0.1531.0"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "libwebkit2gtk-4.1-0"],
        "desktopTemplate": "./linux/jumpserver-client.desktop.hbs"
      },
      "rpm": {}
    }
  },
  "build": {
    "beforeBuildCommand": "pnpm build:ssh-helper:release && pnpm generate:client",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm build:ssh-helper:dev && pnpm dev",
    "devUrl": "http://localhost:3000/luna/"
  },
  "mainBinaryName": "JumpServerClient",
  "productName": "JumpServerClient",
  "version": "4.1.2",
  "identifier": "com.jumpserver.client",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["jms2"]
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "",
        "width": 1300,
        "height": 780,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "withGlobalTauri": false
  }
}
